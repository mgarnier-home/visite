  "sections": [
    {
      "id": "sec-general",
      "name": "Questions générales",
      "kind": "topic",
      "position": 0,
      "points": [],
      "questions": [
        {
          "id": "q-general-1",
          "text": "Pourquoi vendez-vous ? Depuis quand la maison est-elle en vente ?",
          "position": 0,
          "important": false
        },
        {
          "id": "q-general-2",
          "text": "Depuis combien de temps habitez-vous ici ?",
          "position": 1,
          "important": false
        },
        {
          "id": "q-general-3",
          "text": "Le prix est-il négociable ? Y a-t-il déjà eu des offres ?",
          "position": 2,
          "important": false
        },
        {
          "id": "q-general-4",
          "text": "Quelle est la date de libération possible ?",
          "position": 3,
          "important": false
        },
        {
          "id": "q-general-5",
          "text": "Qu'est-ce qui reste dans la maison (cuisine équipée, luminaires, placards, électroménager) ?",
          "position": 4,
          "important": false
        },
        {
          "id": "q-general-6",
          "text": "Quels travaux ont été faits, quand, et par qui ? Avez-vous les factures et garanties (décennale) ?",
          "position": 5,
          "important": false
        },
        {
          "id": "q-general-7",
          "text": "Y a-t-il des travaux à prévoir à court terme ?",
          "position": 6,
          "important": false
        },
        {
          "id": "q-general-8",
          "text": "Y a-t-il déjà eu des dégâts des eaux, des infiltrations, des fissures ou des sinistres déclarés ?",
          "position": 7,
          "important": false
        },
        {
          "id": "q-general-9",
          "text": "Quand la toiture, la chaudière et le chauffe-eau ont-ils été installés ou révisés ?",
          "position": 8,
          "important": false
        },
        {
          "id": "q-general-10",
          "text": "Montant de la taxe foncière ?",
          "position": 9,
          "important": false
        },
        {
          "id": "q-general-11",
          "text": "Factures annuelles d'énergie (électricité, gaz, fioul, bois) ?",
          "position": 10,
          "important": false
        },
        {
          "id": "q-general-12",
          "text": "Tout-à-l'égout ou assainissement individuel (fosse) ? Dernier contrôle SPANC ?",
          "position": 11,
          "important": false
        },
        {
          "id": "q-general-13",
          "text": "Lotissement ou copropriété ? Charges, règlement, ASL ?",
          "position": 12,
          "important": false
        },
        {
          "id": "q-general-14",
          "text": "Le dossier de diagnostics est-il disponible (DPE, amiante, plomb, électricité, gaz, termites, état des risques) ?",
          "position": 13,
          "important": false
        },
        {
          "id": "q-general-15",
          "text": "Y a-t-il des servitudes, un droit de passage, des projets de construction à proximité ?",
          "position": 14,
          "important": false
        },
        {
          "id": "q-general-16",
          "text": "Quelle chambre est la plus chaude ou la plus froide ?",
          "position": 15,
          "important": false
        },
        {
          "id": "q-general-18",
          "text": "Les combles ou le grenier sont-ils aménageables en chambre supplémentaire ? Si oui, quelle serait la hauteur sous plafond ?",
          "position": 16,
          "important": false
        },
        {
          "id": "q-general-plancher",
          "text": "Y a-t-il un plancher chauffant ou une climatisation ?",
          "position": 17,
          "important": false
        }
      ]
    },
